# Colony Sidecar - Example Configuration
# Copy to ~/.colony/.env and fill in your values.
#
# NOTE: Colony does NOT need LLM keys here. The host (Hermes, an MCP client,
# or anything speaking the REST API) provides LLM credentials at runtime via
# POST /v1/host/configure, and they are persisted in the state dir.
#
# `colony init` writes most of this for you. `colony doctor` validates it.

# =============================================================================
# CORE
# =============================================================================

# Bind address — use 0.0.0.0 for remote agent connections
# COLONY_SIDECAR_HOST=0.0.0.0
COLONY_SIDECAR_HOST=127.0.0.1
COLONY_SIDECAR_PORT=7777

# Legacy global bearer (colony init generates one). Keep during scoped-key
# migration, then remove after every consumer has moved.
COLONY_API_KEY=

# Optional mode-0600 JSON principal keyring. See docs/SCOPED-API-AUTH.md.
# COLONY_API_KEYRING_PATH=~/.colony/api-principals.json

# Exact deploy identity exposed only by the authenticated queue contract.
# Generate a deterministic manifest of the files in the deployed artifact,
# record its SHA-256, and pin both values in every external worker.  The
# contract endpoint returns 503 when either value is missing or malformed.
# COLONY_RELEASE_COMMIT=<exact-40-character-lowercase-git-commit>
# COLONY_RELEASE_ARTIFACT_MANIFEST_SHA256=<exact-64-character-lowercase-sha256>

# Exact person IDs used by authenticated audience lanes. OWNER falls back to
# COLONY_OWNER_CONTACT_ID below when COLONY_OWNER_PERSON_ID is unset.
# COLONY_OWNER_PERSON_ID=
# COLONY_SHARED_PERSON_ID=shared
# COLONY_GLOBAL_PERSON_ID=global
# COLONY_DEV_PERSON_ID=dev-anonymous

# Where stores and config live (default ~/.colony)
# COLONY_STATE_DIR=~/.colony

# Durable host-event journal (default <state-dir>/events). Events are written
# before live WebSocket delivery; retention is the replay window.
# COLONY_EVENT_JOURNAL_DIR=~/.colony/events
# COLONY_EVENT_JOURNAL_RETENTION=500

# Per-client host-event WebSocket buffer. A slow client receives an explicit
# overflow frame and reconnects from its last processed journal sequence.
# COLONY_EVENT_SUBSCRIBER_QUEUE_SIZE=256

# Contacts database filename, relative to the state dir
COLONY_CONTACTS_DB=colony-contacts.db

# Graph store (Neo4j 5.x over Bolt)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# The agent's authoritative timezone (temporal awareness)
# COLONY_AGENT_TIMEZONE=UTC
# Owner-local timezone for quiet hours and autonomy scheduling
# COLONY_TIMEZONE=UTC

LOG_LEVEL=info

# =============================================================================
# OWNER & APPROVAL
# =============================================================================

# The owner's contact id. Used by the approval gate, owner-preference
# learning, trust-engine notifications, and the delivery path.
# COLONY_OWNER_CONTACT_ID=

# Approval policy for gated actions: strict (default) or graduated.
# COLONY_APPROVAL_POLICY=strict

# =============================================================================
# AUTONOMY PRESET — the one knob
# =============================================================================
# COLONY_AUTONOMY_PRESET supplies DEFAULTS for all seventeen autonomy flags at
# once. An explicitly set env var always wins over the preset.
#
#   passive     — observe and remember only; nothing thinks, acts, or writes.
#   calibration — everything runs in shadow/dry_run and EARNS autonomy through
#                 the trust engine (the recommended starting point; the wizard
#                 default). Capability classes auto-graduate from their real
#                 track record, notifying the owner.
#   autonomous  — subsystems run live, still bounded by directive boundaries,
#                 approval tiering, the immutable floor, and trust gating.
#
# The sandbox never goes live from a preset ("autonomous" caps it at dry_run);
# live code execution is always an explicit per-deployment decision.
#
# GET /v1/host/autonomy/posture returns the RESOLVED posture of the running
# process.
# COLONY_AUTONOMY_PRESET=calibration

# --- Per-subsystem overrides (each one beats the preset when set) -----------

# In-process initiative executor (reasons about initiatives with the agent's
# own LLM + tools): true / false
# COLONY_EXECUTOR_ENABLED=true
# COLONY_EXECUTOR_MODEL_TIER=small          # small / medium / large
# COLONY_EXECUTOR_TYPES=                    # csv of initiative types to handle
# COLONY_EXECUTOR_CYCLE_SECS=30
# COLONY_EXECUTOR_MAX_PER_CYCLE=5
# COLONY_EXECUTOR_MAX_TOOL_ITERS=           # max tool rounds per initiative

# Background cognition and per-turn introspection: true / false
# COLONY_COGNITION_ENABLED=true
# COLONY_INTROSPECT_ENABLED=true

# Self-directed thinking (proposals from idle reflection): off / shadow / live
# COLONY_THINKING_MODE=shadow
# COLONY_THINKING_INTERVAL_SECS=3600
# COLONY_THINKING_MAX_INITIATIVES=3

# Goal persistence / multi-step project pursuit: off / shadow / live
# COLONY_PROJECTS_MODE=shadow

# Typed P3 cognition spine: off / shadow / live. P6 live and all P7 modes
# require this graph to be attached successfully.
# COLONY_COGNITION_SPINE=off
# Evidence-derived P6 situation spine: off / shadow / live. shadow is strictly
# observer-only; live composes P3 capacity and fails closed on missing context.
# COLONY_SITUATION_SPINE=off
# Initial journal cursor when P6 first opens: tail (live canary) / replay.
# COLONY_SITUATION_BOOTSTRAP=tail
# Periodic reducer cadence; startup bounds this to 5..3600 seconds.
# COLONY_SITUATION_REDUCE_INTERVAL_SECONDS=30
# Owner-ratified P7 drive/charter governance: off / shadow / live. Ranking
# never admits a project or grants execution authority.
# COLONY_DRIVE_GOVERNANCE_MODE=off  # off|shadow|bootstrap|live

# Belief maintenance (contradiction detection, resolution, decay):
# off / shadow / live
# COLONY_BELIEFS_MODE=shadow

# World-model population from conversation: off / shadow / live
# COLONY_WORLD_POPULATE_MODE=shadow
# LLM-assisted world extraction: off / shadow / live
# COLONY_WORLD_LLM_EXTRACT=shadow

# Skill distillation (compounding procedure memory): off / shadow / live
# COLONY_SKILLS_DISTILL=shadow

# Escalation mining (spot correction/consultation turns for
# self-improvement): off / shadow / live
# COLONY_ESCALATION_MINING=shadow
# Training-corpus exporter (POST /v1/host/mining/corpus/export; writes JSONL
# under the state dir only): true / false
# COLONY_CORPUS_EXPORT_ENABLED=true

# Directed action via delegation: off / dry_run / live
# COLONY_DIRECTED_MODE=dry_run
# COLONY_DIRECTED_TASK_URL=

# =============================================================================
# CONNECTORS (senses) — read-only pull connectors
# =============================================================================
# COLONY_CONNECTORS_MODE: off / shadow / live. In shadow, connectors poll and
# LOG what they would ingest, writing nothing. Each connector is then enabled
# and configured individually via COLONY_CONNECTOR_<NAME>_<KEY>.
# COLONY_CONNECTORS_MODE=shadow

# IMAP email (read-only; never sends)
# COLONY_CONNECTOR_IMAP_ENABLED=true
# COLONY_CONNECTOR_IMAP_HOST=imap.example.com
# COLONY_CONNECTOR_IMAP_PORT=993
# COLONY_CONNECTOR_IMAP_USER=
# COLONY_CONNECTOR_IMAP_PASSWORD=
# COLONY_CONNECTOR_IMAP_MAILBOX=INBOX
# COLONY_CONNECTOR_IMAP_MAX=20
# COLONY_CONNECTOR_IMAP_POLL_SECS=900

# Calendar via ICS URL (read-only)
# COLONY_CONNECTOR_CALENDAR_ENABLED=true
# COLONY_CONNECTOR_CALENDAR_ICS_URL=https://example.com/calendar.ics
# COLONY_CONNECTOR_CALENDAR_USER=
# COLONY_CONNECTOR_CALENDAR_PASSWORD=
# COLONY_CONNECTOR_CALENDAR_POLL_SECS=1800

# Filesystem documents (watch a folder)
# COLONY_CONNECTOR_FS_ENABLED=true
# COLONY_CONNECTOR_FS_PATH=~/Documents/inbox
# COLONY_CONNECTOR_FS_EXTENSIONS=txt,md,pdf,docx
# COLONY_CONNECTOR_FS_POLL_SECS=600

# Generic webhook pull (poll a JSON endpoint)
# COLONY_CONNECTOR_WEBHOOK_ENABLED=true
# COLONY_CONNECTOR_WEBHOOK_URL=
# COLONY_CONNECTOR_WEBHOOK_AUTH_HEADER=
# COLONY_CONNECTOR_WEBHOOK_AUTH_VALUE=
# COLONY_CONNECTOR_WEBHOOK_FIELD_MAP={}
# COLONY_CONNECTOR_WEBHOOK_POLL_SECS=3600

# =============================================================================
# WORKERS — distributed job execution (server-governed)
# =============================================================================
# COLONY_WORKERS_MODE gates the server-side WorkerGovernor: off / shadow /
# live. Workers are untrusted; claims and reports are re-verified server-side.
# COLONY_WORKERS_MODE=shadow
# COLONY_WORKER_AUTHORITY_MODE separately gates HTTP worker identity:
# shadow keeps legacy/global-bearer consumers usable and records their future
# denial posture; enforce requires workers:register / workers:claim /
# workers:lifecycle plus an exact private-keyring worker_grant. Migrate every
# worker and observe normal use before changing this from shadow.
# COLONY_WORKER_AUTHORITY_MODE=shadow
# Generic installs keep the embedded in-process worker enabled. Health-only
# cutovers may set this false without disabling the independent queue
# scheduler, lease/deadline cleanup, or durable outcome reconciliation.
# COLONY_EMBEDDED_WORKER_ENABLED=true
# COLONY_QUEUE_SCHEDULER_TICK_SECS=2
# COLONY_QUEUE_CLAIM_TIMEOUT_SECS=30
# COLONY_QUEUE_HEARTBEAT_TIMEOUT_SECS=60
# Shadow executes only server-proven no-effect work; mutation/disclosure jobs
# are held without running. Embedded maintenance is additionally confined to
# COLONY_MAINTENANCE_ROOTS, then COLONY_STATE_DIR, then COLONY_HOME.
# COLONY_MAINTENANCE_ROOTS=/var/lib/colony
# Monitoring rejects private/link-local/loopback endpoints unless the exact
# host (or an intentional *.suffix) is listed here.
# COLONY_MONITORING_HOST_ALLOWLIST=
# Set this to the same per-route HMAC secret configured in Hermes. Colony
# signs exact webhook bytes with Hermes' timestamped V2 signature headers.
# COLONY_HERMES_WEBHOOK_SECRET=
# COLONY_HERMES_WEBHOOK_V1_COMPAT=false
# Candidate containment: disable every generic agent_action claim loop without
# disabling initiative forwarding. Re-enable only after disjoint route grants
# and subtype/result tests prove ownership.
# COLONY_AGENT_JOB_CLAIMS_ENABLED=true
# Exact non-effect routes advertised by generic Agent Bridge/queue workers.
# Combined deployment (default): agent_sync,hermes_run. Split deployments use
# one value per worker. action_plane/work_order are deliberately rejected here.
# COLONY_AGENT_WORKER_ROUTES=agent_sync,hermes_run
# Optional exact route owners (capability routing remains mandatory too).
# COLONY_AGENT_SYNC_WORKER_NODE_ID=
# COLONY_HERMES_RUN_WORKER_NODE_ID=
# COLONY_ACTION_PLANE_WORKER_NODE_ID=
# Exact node returned by get_or_create_node_id for the embedded/private P3
# ThoughtJobV1 inference handler. Leave unset only for portable dev installs.
# COLONY_THOUGHT_WORKER_NODE_ID=
# The standalone colony-memory provider does not expose queue mutation tools
# unless explicitly opted in. When the general Colony plugin is active it is
# always reduced to its non-duplicating read/context surface.
# COLONY_MEMORY_WORKER_TOOLS=0
# Governed Hermes coexistence latches. Set these exact values together only
# when the general plugin is the canonical turn writer.
# COLONY_GENERAL_PLUGIN_ACTIVE=1
# COLONY_MEMORY_TURN_WRITER=disabled
# The general plugin resolves this credential placeholder in Hermes config;
# leave it unset when no action mediator is deployed.
# COLONY_ACTION_MEDIATOR_API_KEY=
# Optional absolute durable-outbox override (default ~/.hermes/state/...).
# COLONY_HERMES_TURN_OUTBOX=
# Standalone provider identity/capabilities are operator configuration, never
# model arguments. The provider always strips the WorkOrder protocol route.
# COLONY_MEMORY_WORKER_NODE_ID=colony-memory-worker
# COLONY_MEMORY_WORKER_CAPABILITIES=agent_action
# Shared-provider privacy is mandatory and cannot be disabled. Query, session,
# sender, channel, and resolved-contact bindings prevent cross-turn cache use.
# Only an explicitly attested CLI/system owner lane may use the default; set
# COLONY_MCP_CONTACT_ID to the exact owner contact, never a generic "default".
# COLONY_PREFETCH_QUERY_CHECK=1
# COLONY_PREFETCH_TURN_CONTACT=1
# COLONY_MEMORY_DEFAULT_CONTEXT_AUTHORITY=none
# COLONY_MCP_CONTACT_ID=replace-with-exact-owner-contact-id
# Guest context also requires an exact scoped channel principal/contact grant
# and an attached P8 scoped projection. The currently wired canary is
# COLONY_RECIPIENT_SIMULATOR_MODE=shadow; without it guest context is withheld.

# The `colony-worker` daemon (systemd/launchd templates ship under
# sidecar/colony_sidecar/workers/deploy/):
# COLONY_WORKER_NODE_ID=                    # default <agent>-worker
# COLONY_WORKER_CAPABILITIES=research,analyst,read
# COLONY_WORKER_JOB_TYPES=research
# COLONY_WORKER_MAX_JOBS=1
# COLONY_WORKER_POLL_SECS=30
# COLONY_WORKER_LLM_BASE_URL=               # default OPENAI_BASE_URL
# COLONY_WORKER_LLM_MODEL=gpt-4o-mini
# COLONY_WORKER_LLM_API_KEY=                # default OPENAI_API_KEY

# =============================================================================
# SANDBOX — gated Docker exploration sandbox
# =============================================================================
# off / dry_run / live. Live runs scripts in a locked-down container
# (--network none, no credentials, read-only rootfs, capped resources) behind
# boundary checks and approval tiering. Never enabled live by a preset.
# COLONY_SANDBOX_MODE=off
# COLONY_SANDBOX_IMAGE=python:3.12-slim
# COLONY_SANDBOX_CPUS=1.0
# COLONY_SANDBOX_MEMORY=512m
# COLONY_SANDBOX_TIMEOUT=30
# COLONY_SANDBOX_PIDS=128
# COLONY_SANDBOX_EGRESS=none                # keep "none" unless you know why
# COLONY_SANDBOX_MAX_ARTIFACT_BYTES=1048576

# =============================================================================
# TRUST ENGINE — earned, graduated autonomy
# =============================================================================
# Per action class: shadow -> ask_first -> act_first, driven by the real
# journaled track record. Defaults are sane; override with care.
# COLONY_TRUST_AUTOGRADUATE=true            # false = stages never auto-promote
# COLONY_TRUST_ACT_THRESHOLD=0.8            # confidence needed to act
# COLONY_TRUST_ASK_MIN_N=3                  # clean shadow runs to reach ask_first
# COLONY_TRUST_ACT_MIN_N=5                  # real outcomes to reach act_first
# COLONY_TRUST_READ_ONLY_TRIAL_MAX=5        # bounded no-effect live trials at ask_first (defaults to ACT_MIN_N)
# COLONY_ACTION_RECEIPT_CLOCK_SKEW_SECS=300 # verifier observed_at skew allowance (hard-capped at 900s)
# COLONY_TRUST_BREAKER_FAILURES=3           # failures in window -> demote
# COLONY_TRUST_BREAKER_WINDOW_HOURS=24
# Ceiling of the adaptive daily proactive-delivery cap
# COLONY_TRUST_DELIVERY_CAP_MAX=6

# =============================================================================
# DELIVERY & HOME CHANNEL
# =============================================================================
# Where proactive initiatives are delivered. Set at least one home channel
# (<PLATFORM>_HOME_CHANNEL) or initiatives will queue but never deliver:
# TELEGRAM_HOME_CHANNEL=
# WHATSAPP_HOME_CHANNEL=
# DISCORD_HOME_CHANNEL=
# SLACK_HOME_CHANNEL=
# SIGNAL_HOME_CHANNEL=

# Transport for reach-out delivery:
#   hermes_webhook (default) — POST the structured initiative to a composing
#                              agent's webhook, which writes the final message
#   gateway                  — POST sanitised text to a message gateway that
#                              speaks the flat {platform, chat_id, message}
#                              contract
# COLONY_DELIVERY_TRANSPORT=hermes_webhook

# Built-in agent bridge (forwards initiatives/jobs to a host webhook; the
# service auto-starts at boot when this is set):
# COLONY_BRIDGE_WEBHOOK_URL=

# =============================================================================
# MODELS & SEARCH
# =============================================================================

# HuggingFace token for faster model downloads (optional)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxx

# Embedding + reranker — auto-detected by colony init.
# Override here for API embeddings or a custom model.
COLONY_EMBED_PROVIDER=
COLONY_EMBED_MODEL=
COLONY_EMBED_DIMS=
COLONY_RERANKER_MODEL=

# Multimodal embeddings (enable with `colony activate-multimodal`)
COLONY_MULTIMODAL=false

# Web search for the research pipeline. Unset = keyless DuckDuckGo fallback.
# COLONY_SEARCH_PROVIDER=tavily             # tavily / brave / serpapi
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPAPI_KEY=

# =============================================================================
# INITIATIVE ENGINE THRESHOLDS
# =============================================================================
# How sensitive proactive initiative generation is.

# Days of no contact before generating a relationship initiative (default: 7)
# COLONY_INITIATIVE_CONTACT_NEGLECT_DAYS=7

# Days a goal must be blocked before generating a follow-up (default: 1)
# COLONY_INITIATIVE_GOAL_BLOCK_DAYS=1

# Health score threshold — below this generates an alert (default: 70.0)
# COLONY_INITIATIVE_HEALTH_THRESHOLD=70.0

# Minimum calendar gap (hours) to count as opportunity (default: 2.0)
# COLONY_INITIATIVE_GAP_THRESHOLD=2.0

# Research task age (days) before generating an initiative (default: 1)
# COLONY_INITIATIVE_RESEARCH_AGE_DAYS=1

# Signal accumulation threshold before generating an initiative (default: 10)
# COLONY_INITIATIVE_SIGNAL_THRESHOLD=10

# ── Relationship intelligence (docs/RELATIONSHIPS.md) ────────────────────────
# Unknown senders become shadow contacts so history accrues from first
# contact (default: true)
# COLONY_IDENTITY_SHADOW_CONTACTS=true

# Channel prefixes whose senderless turns attribute to the machine sentinel
# instead of a person (default: cron,api,internal)
# COLONY_IDENTITY_MACHINE_CHANNELS=cron,api,internal

# New interactions before a contact is (re)profiled (default: 5)
# COLONY_RELATIONSHIP_PROFILE_MIN_INTERACTIONS=5

# Relationship profiling phase cadence in seconds (default: 21600)
# COLONY_RELATIONSHIP_PROFILE_REFRESH_SECS=21600

# Include approach guidance (best channel/time, engagement style) in
# relationship briefs (default: true)
# COLONY_APPROACH_GUIDANCE=true

# Extra keyword-match common terms the boundary matcher must never treat as
# a lone match signal (csv; the product and agent names are always included)
# COLONY_MATCH_COMMON_TERMS=

# --- Selfhood benchmark (Mind M0a) ---
# Weekly self-improvement metrics derived from journals (never self-reported).
# COLONY_BENCHMARK_ENABLED=true
# Deliver the weekly scorecard to the owner as a proposal.
# COLONY_BENCHMARK_REPORT=true
# Recall probes per weekly compute (high-confidence facts re-queried).
# COLONY_BENCHMARK_PROBES=8

# --- Experiment framework (Mind M0b) ---
# Master availability. P4 behavior remains dark unless the mode below is
# explicitly shadow/live.
# COLONY_EXPERIMENTS_ENABLED=true
# Concurrent running experiments cap.
# COLONY_EXPERIMENTS_MAX_RUNNING=2
# off | shadow | live (default off). shadow records assignments and
# receipt-linked outcomes but never mutates a parameter. live requires an
# exact reversible pregrant or bounded owner approval.
# COLONY_COGNITION_P4_MODE=off
# Optional JSON object of parameter -> [lo,hi]. Leave empty to require owner
# approval for every live experiment mutation. Keep ranges narrow.
# COLONY_EXPERIMENT_PREGRANTS_JSON=

# --- Toolsmith (Mind M1): self-built, sandbox-verified tools ---
# off | shadow | live. Both enabled modes may mine, draft, and verify pure
# tools. Graduation always needs same-input comparison receipts plus a
# one-shot owner-scoped authority; trust never publishes code. Requires the
# Docker sandbox (COLONY_SANDBOX_MODE=live) to verify and run tools.
# COLONY_TOOLSMITH=off
# Journal occurrences before a procedure becomes a tool candidate.
# COLONY_TOOLSMITH_MIN_OCCURRENCES=4
# Clean receipt-backed incumbent/candidate comparisons before eligibility.
# Legacy/self-test shadow counters do not count.
# COLONY_TOOLSMITH_SHADOW_MIN=5
# Journal domains never mined for tools.
# COLONY_TOOLSMITH_EXCLUDE_DOMAINS=meta_learning,sandbox,toolsmith

# --- Cognitive workspace (Mind M2): continuity of thought ---
# off | shadow | live. shadow: concerns accrue, decay, and get thought about
# (journaled), no side effects. live: a thought may surface an initiative to
# the owner or propose a self-experiment.
# COLONY_WORKSPACE=off
# Max concerns held on her mind (lowest-salience evicted past this).
# COLONY_WORKSPACE_CAPACITY=24
# Salience half-life in hours (time decay).
# COLONY_WORKSPACE_HALFLIFE_HOURS=12
# Thoughts a single concern may receive before it rests.
# COLONY_WORKSPACE_THOUGHT_BUDGET=8
# Nightly window (process local time) for the heavy standing agenda; empty
# disables. Wrap-around allowed (22:00-06:00). During it she thinks more.
# COLONY_SLEEP_WINDOW=

# --- Expectation engine (Mind M3a): predictions + surprise + calibration ---
# off | shadow | live. Forms predictions (e.g. a commitment gets done by its
# due date) and resolves them at their horizon; a miss becomes a surprise on
# her mind and feeds a per-domain calibration (Brier) score into the
# benchmark as calibration.<domain>.
# COLONY_EXPECTATIONS=off

# --- P8 recipient-scoped social context (non-real-time shadow only) ---
# off | shadow | live. The shared integration attaches ONLY for explicit
# shadow. Unset, unknown, off, and live create no P8 integration state and
# have no delivery/context effect. Shadow records ignored advisory evidence;
# it never blocks, authorizes, mutates, or sends. Voice/phone/intercom/Meet
# are excluded from the observer entirely.
# COLONY_RECIPIENT_SIMULATOR_MODE=off
# Freshness used only when a newly authorized SharedFacts row has no explicit
# expiry. Bounded by the server to 1..3650 days (default 30).
# COLONY_P8_FACT_TTL_DAYS=30
# Strictly positive fact confidence floor used before every P8 context,
# relationship, Deck, and recipient-simulation projection (default 0.5).
# Invalid, zero, negative, and >1 values fail safe to 0.5.
# COLONY_P8_FACT_MIN_CONFIDENCE=0.5

# ---------------------------------------------------------------------------
# Enforcement modes
# ---------------------------------------------------------------------------
# These control whether a subsystem ENFORCES or merely EVALUATES. Every one of
# them ships in a non-enforcing posture. Leaving them unset is a valid choice,
# but be clear about what it means: decisions are recorded, not applied. Audit
# rows showing a verdict are evidence that a check RAN, not that it ACTED.
# See "Operational posture" in README.md for the full table.
#
# Outbound response guard. Anything other than the exact literal "enforce"
# resolves to shadow (evaluate, never block). An unrecognised value now refuses
# at startup rather than silently degrading.
# COLONY_GUARD_MODE=shadow
#
# Which guard checks may actually block when the guard IS in enforce mode.
# Defaults to secret_leak,tom2_epistemic only, so a block-severity finding from
# any other check still ships. Set to "all" to let every check block.
# COLONY_GUARD_ENFORCE_CHECKS=secret_leak,tom2_epistemic
#
# Approval decisions. In shadow, an authorization deficit is recorded as
# shadow_compat evidence and the action proceeds anyway.
# COLONY_APPROVAL_AUTHORITY_MODE=shadow
#
# Worker claim authority. In shadow, a claim that fails capability, boundary,
# and trust checks is still allowed for non-effectful jobs.
# COLONY_WORKER_AUTHORITY_MODE=shadow
#
# Cross-encoder reranking of recall results. off | shadow | on.
# In shadow the reranker runs and logs the rank delta, then returns the
# original ANN order unchanged, so you can measure whether it helps before
# paying its latency.
# COLONY_RECALL_RERANK=off
